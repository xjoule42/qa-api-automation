					"script": {
						"exec": [
							"pm.test(\"First Post\", function () {\r",
							"    let json = pm.response.json();\r",
							"    pm.environment.set(\"postId\", json.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Post ID is not null\", function () {\r",
							"    let postId = pm.environment.get(\"postId\");\r",
							"})\r",
							"\r",
							""
						],
