				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"})\r",
							"\r",
							"pm.test(\"Response time is less than 200ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(200);\r",
							"})\r",
							"\r",
							"pm.test(\"Response body contains the correct post id\", function () {\r",
							"    pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"postId\"));\r",
							"})\r",
							"\r",
							"pm.test(\"Response body contains the correct title\", function () {\r",
							"    pm.expect(pm.response.json().title).to.eql(\"updated title\");\r",
							"})\r",
							"\r",
							"pm.test(\"Response body contains the correct body\", function () {\r",
